{
   "name": "nocturnal",
   "private": true,
   "version": "1.0.0",
   "author": "A New Level Media <anewlevelmp@gmail.com>",
   "description": "Nocturnal is a fork of the cross-platform Insomnia REST client, built on top of Electron.",
   "license": "MIT",
   "repository": "https://github.com/a-new-level-dev/nocturnal",
   "bugs": {
      "url": "https://github.com/a-new-level-dev/nocturnal/issues"
   },
   "homepage": "https://github.com/a-new-level-dev/nocturnal#readme",
   "engines": {
      "node": ">=22.11.0",
      "yarn": ">=1.22.0"
   },
   "workspaces": [
      "packages/insomnia-inso",
      "packages/insomnia-send-request",
      "packages/insomnia-smoke-test",
      "packages/insomnia-testing",
      "packages/insomnia",
      "packages/openapi-2-kong"
   ],
   "scripts": {
      "dev": "yarn workspace packages/insomnia start",
      "lint": "yarn workspaces foreach --all run lint",
      "type-check": "yarn workspaces foreach --all run type-check",
      "test": "yarn workspaces foreach --all run test",
      "lint:markdown": "yarn dlx markdownlint-cli2 \"**/*.md\" \"#**/node_modules\"",
      "clean": "git clean -dfX",
      "inso-start": "yarn workspace packages/insomnia-inso start",
      "inso-package": "yarn workspace packages/insomnia run build:sr && yarn workspace packages/insomnia-inso run package",
      "inso-package:artifacts": "yarn workspace packages/insomnia-inso run artifacts",
      "test:bundled-inso": "yarn workspace packages/insomnia-inso run build && yarn workspace packages/insomnia-inso run test:bundled-inso",
      "watch:app": "yarn workspace packages/insomnia run build:main.min.js && yarn workspace packages/insomnia run start:dev-server",
      "app-build": "yarn workspace packages/insomnia run build",
      "app-package": "yarn workspace packages/insomnia run package",
      "test:smoke:dev": "yarn workspace packages/insomnia-smoke-test run test:dev -- --project=Smoke",
      "test:smoke:build": "yarn workspace packages/insomnia-smoke-test run test:build -- --project=Smoke",
      "test:smoke:package": "yarn workspace packages/insomnia-smoke-test run test:package -- --project=Smoke",
      "test:smoke:cli": "yarn workspace packages/insomnia-smoke-test run test:cli",
      "changelog-image": "esr ./scripts/changelog-image/changelog-image.ts",
      "download-all-npm-plugins": "esr ./scripts/download-all-npm-plugins.ts"
   },
   "devDependencies": {
      "@jest/globals": "^28.1.0",
      "@jest/types": "^28.1.0",
      "@types/chai": "^4.3.5",
      "@types/eslint": "^8.4.3",
      "@types/mocha": "^10.0.1",
      "@types/node": "^20.3.3",
      "@types/svgo": "^2.6.3",
      "@typescript-eslint/eslint-plugin": "^6.3.0",
      "@typescript-eslint/parser": "^6.3.0",
      "esbuild": "^0.16.0",
      "esbuild-runner": "^2.2.2",
      "eslint": "^8.44.0",
      "eslint-config-helpers": "^1.2.0",
      "eslint-plugin-filenames": "^1.3.2",
      "eslint-plugin-html": "^7.1.0",
      "eslint-plugin-import": "^2.27.5",
      "eslint-plugin-jest": "^27.2.3",
      "eslint-plugin-json": "^3.1.0",
      "eslint-plugin-react": "^7.32.2",
      "eslint-plugin-react-hooks": "^4.6.0",
      "eslint-plugin-simple-import-sort": "^10.0.0",
      "jest": "^28.1.0",
      "svg-text-to-path": "^1.1.2",
      "svgo": "^2.8.0",
      "ts-jest": "^28.0.1",
      "tslib": "2.0.1",
      "type-fest": "^2.12.0",
      "typescript": "^5.1.6"
   }
}
